{
  "name": "Cirron",
  "email": "dx@cirron.com",
  "owner": "cirron",
  "repo": "cirron-sdk",
  "baseBranch": "main",
  "prereleaseBranches": [
    "rc"
  ],
  "noVersionPrefix": false,
  "plugins": [
    "git-tag",
    "released",
    "first-time-contributor"
  ],
  "labels": [
    {
      "name": "enhancement",
      "changelogTitle": "🚀 Enhancement",
      "description": "New or improved behavior; increments the minor version",
      "releaseType": "minor"
    },
    {
      "name": "bug",
      "changelogTitle": "🐛 Bug Fix",
      "description": "Fixes broken behavior; increments the patch version",
      "releaseType": "patch"
    },
    {
      "name": "release: major",
      "changelogTitle": "💥 Breaking Change",
      "description": "Increment the major version when merged",
      "releaseType": "major"
    },
    {
      "name": "release: minor",
      "changelogTitle": "🚀 Enhancement",
      "description": "Increment the minor version when merged",
      "releaseType": "minor"
    },
    {
      "name": "release: patch",
      "changelogTitle": "🐛 Bug Fix",
      "description": "Increment the patch version when merged",
      "releaseType": "patch"
    },
    {
      "name": "skip-release",
      "description": "Skip the release for this PR",
      "releaseType": "skip"
    },
    {
      "name": "release",
      "description": "Force a release for this PR",
      "releaseType": "release"
    },
    {
      "name": "internal",
      "changelogTitle": "🏠 Internal",
      "description": "Changes that affect tooling or development workflow",
      "releaseType": "none"
    },
    {
      "name": "documentation",
      "changelogTitle": "📝 Documentation",
      "description": "Changes to documentation only",
      "releaseType": "none"
    }
  ]
}
